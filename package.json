{
  "name": "meowku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --mode hosted",
    "dev:local": "vite --configLoader runner --mode development",
    "dev:hosted": "vite --configLoader runner --mode hosted",
    "build": "tsc -b && vite build --configLoader runner",
    "typecheck": "tsc -b",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-router": "^1.120.5",
    "@tanstack/router-devtools": "^1.120.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.153.0"
  }
}
